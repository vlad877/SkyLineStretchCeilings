# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_ to the
# browser — everything else stays server-side.

# --- Site ------------------------------------------------------------------
# Production origin, WITH the scheme and no trailing slash. Used to build
# sitemap.xml and the Sitemap line in robots.txt. Leave empty and the sitemap
# is skipped rather than generated with a wrong or relative domain.
VITE_SITE_URL=

# --- Lead delivery ---------------------------------------------------------
# At least one channel must be configured, or the form returns 500.
# A lead counts as delivered if any configured channel accepts it.

# Telegram — from @BotFather. Chat id: message the bot, then read
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email — https://resend.com, an HTTPS API (SMTP cannot run on Cloudflare
# Workers). LEAD_EMAIL_TO accepts several addresses separated by commas.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# Optional. Needs a domain verified in Resend; without one, leave it unset and
# the default onboarding@resend.dev sender is used.
LEAD_EMAIL_FROM=

# --- reCAPTCHA v3 (optional) -----------------------------------------------
# Register every host that serves the form, including <project>.pages.dev so
# Cloudflare preview deployments are covered.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
